# Base URL API backend Laravel TailorLX
API_BASE_URL=http://192.168.1.5:8000

# Reverb WebSocket Configuration
# REVERB_APP_KEY: Must match backend REVERB_APP_KEY
REVERB_APP_KEY=tailorlx_dev_key

# REVERB_CLUSTER: Region cluster (mt1 for development)
REVERB_CLUSTER=mt1

# REVERB_HOST: Host and port of Reverb server
# For local development: 127.0.0.1:8080 or localhost:8080
# For network access: use your machine's IP, e.g., 192.168.1.100:8080
REVERB_HOST=127.0.0.1:8080
